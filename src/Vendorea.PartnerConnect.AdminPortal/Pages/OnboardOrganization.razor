@page "/onboard-organization"
@attribute [Authorize(Roles = "Admin,Support")]
@inject ApiClient Api

<PageTitle>Onboard Organization - PartnerConnect Admin</PageTitle>

<h1>Onboard Organization</h1>
<p class="text-muted">
    Create an organization and stand it up in one step: it is activated immediately, its plan
    subscription is created, and an activation invite is emailed to the first admin. Use this for
    operator-led onboarding instead of waiting for a self-service registration. Portal URLs, API keys
    and trading partners are set afterwards from <a href="organizations">Organizations</a>.
</p>

@if (!string.IsNullOrEmpty(message))
{
    <div class="alert @(succeeded ? "alert-success" : "alert-danger") alert-dismissible" role="alert">
        @message
        <button type="button" class="btn-close" @onclick="() => message = null"></button>
    </div>
}

<div class="row">
    <div class="col-lg-8">
        <div class="card">
            <div class="card-header">
                <span class="oi oi-plus me-1"></span> New Organization
            </div>
            <div class="card-body">
                <div class="mb-3">
                    <label class="form-label" for="orgName">Organization Name <span class="text-danger">*</span></label>
                    <input type="text" class="form-control" id="orgName" @bind="form.OrganizationName" placeholder="e.g., Acme Corporation" />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="planCode">Billing Plan <span class="text-danger">*</span></label>
                        <select class="form-select" id="planCode" @bind="form.PlanCode">
                            <option value="">Select a plan...</option>
                            @foreach (var plan in billingPlans)
                            {
                                <option value="@plan.Code">@plan.Name (@plan.Code) - @plan.MonthlyPrice.ToString("C")/mo</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="isMultiTenant">Organization Type</label>
                        <div class="form-check mt-2">
                            <input type="checkbox" class="form-check-input" id="isMultiTenant"
                                   @bind="form.IsMultiTenant" aria-describedby="isMultiTenantHelp" />
                            <label class="form-check-label" for="isMultiTenant">Multi-tenant</label>
                        </div>
                        <div class="form-text" id="isMultiTenantHelp">
                            Tick if the organization will trade under more than one tenant. This cannot be
                            changed once the organization exists.
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="contactEmail">Contact Email</label>
                        <input type="email" class="form-control" id="contactEmail" @bind="form.ContactEmail"
                               placeholder="accounts@example.com" aria-describedby="contactEmailHelp" />
                        <div class="form-text" id="contactEmailHelp">
                            The organization's own address. Defaults to the administrator's if left blank.
                        </div>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="contactPhone">Contact Phone</label>
                        <input type="text" class="form-control" id="contactPhone" @bind="form.ContactPhone" placeholder="Optional" />
                    </div>
                </div>

                <hr class="my-4" />

                <h2 class="h6 text-muted text-uppercase mb-3">First Administrator</h2>
                <p class="text-muted small">
                    This person receives an activation email and becomes the organization's first admin.
                </p>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="adminName">Admin Display Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="adminName" @bind="form.AdminDisplayName" placeholder="e.g., Jane Smith" />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="adminEmail">Admin Email <span class="text-danger">*</span></label>
                        <input type="email" class="form-control" id="adminEmail" @bind="form.AdminEmail" placeholder="admin@example.com" />
                    </div>
                </div>

                <div class="d-flex justify-content-end">
                    <button class="btn btn-primary" @onclick="SubmitAsync" disabled="@(!CanSubmit || isSubmitting)">
                        @if (isSubmitting)
                        {
                            <span class="spinner-border spinner-border-sm me-1"></span>
                        }
                        <span class="oi oi-check me-1"></span> Create &amp; Invite Admin
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private OnboardOrganizationRequest form = new();
    private List<BillingPlanDto> billingPlans = new();

    private bool isSubmitting;
    private string? message;
    private bool succeeded;

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(form.OrganizationName)
        && !string.IsNullOrWhiteSpace(form.PlanCode)
        && !string.IsNullOrWhiteSpace(form.AdminDisplayName)
        && !string.IsNullOrWhiteSpace(form.AdminEmail);

    protected override async Task OnInitializedAsync()
    {
        billingPlans = await Api.GetBillingPlansAsync();
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        isSubmitting = true;
        message = null;
        StateHasChanged();
        try
        {
            var (result, error) = await Api.OnboardOrganizationAsync(form);
            if (result is not null)
            {
                succeeded = true;
                message = $"{result.Organization.Name} created — an activation invite was emailed to "
                        + $"{result.InvitedAdminEmail}. Set its portal, API keys and trading partners "
                        + "from Organizations.";
                form = new OnboardOrganizationRequest();
            }
            else
            {
                succeeded = false;
                message = error ?? "Failed to onboard the organization.";
            }
        }
        finally
        {
            isSubmitting = false;
            StateHasChanged();
        }
    }
}
