@implements IDisposable
@inject NavigationManager Navigation

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">PartnerConnect Admin</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass nav-scrollable" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard
            </NavLink>
        </div>

        @foreach (var group in Groups)
        {
            var isOpen = openGroups.Contains(group.Title);
            var panelId = $"nav-group-{group.Title.ToLowerInvariant().Replace(" ", "-").Replace("&", "and")}";

            <div class="nav-group">
                <button type="button"
                        class="nav-group-toggle"
                        aria-expanded="@isOpen.ToString().ToLowerInvariant()"
                        aria-controls="@panelId"
                        @onclick="() => ToggleGroup(group.Title)"
                        @onclick:stopPropagation="true">
                    <span class="oi @group.Icon" aria-hidden="true"></span>
                    <span class="nav-group-title">@group.Title</span>
                    <span class="oi @(isOpen ? "oi-chevron-bottom" : "oi-chevron-right") nav-group-chevron" aria-hidden="true"></span>
                </button>

                <div id="@panelId" class="nav-group-items @(isOpen ? "" : "d-none")">
                    @foreach (var entry in group.Items)
                    {
                        @if (entry.Policy is null)
                        {
                            @NavEntryLink(entry)
                        }
                        else
                        {
                            <AuthorizeView Policy="@entry.Policy">
                                <Authorized>@NavEntryLink(entry)</Authorized>
                            </AuthorizeView>
                        }
                    }
                </div>
            </div>
        }
    </nav>
</div>

@code {
    private bool collapseNavMenu = true;
    private readonly HashSet<string> openGroups = new();

    private string? NavMenuCssClass => collapseNavMenu ? "collapse" : null;

    /// <summary>A single destination. <see cref="Policy"/> gates it behind an authorization policy.</summary>
    private sealed record NavEntry(string Href, string Icon, string Label, string? Policy = null);

    /// <summary>A collapsible section of the sidebar.</summary>
    private sealed record NavGroup(string Title, string Icon, NavEntry[] Items);

    // The sidebar, in the order an operator works through it: who the customer is, what they trade
    // under, what data flows in, what the system did, and finally the tools for running it.
    private static readonly NavGroup[] Groups =
    {
        new("Organizations", "oi-organization", new NavEntry[]
        {
            new("organizations", "oi-list-rich", "All Organizations"),
            new("registration-requests", "oi-inbox", "Registration Requests", "RequireOperator"),
            new("onboard-organization", "oi-plus", "Onboard Organization", "RequireOperator"),
            new("billing", "oi-credit-card", "Billing Plans")
        }),
        new("Tenants", "oi-person", new NavEntry[]
        {
            new("tenants", "oi-list-rich", "All Tenants"),
            new("tenant-connections", "oi-link-intact", "Partner Connections")
        }),
        new("Partners & Content", "oi-box", new NavEntry[]
        {
            new("partners", "oi-people", "Trading Partners", "RequireAdmin"),
            new("pricefeeds", "oi-spreadsheet", "Price Feeds"),
            new("content", "oi-image", "Enhanced Content"),
            new("ftp-ingestion", "oi-cloud-download", "Content Ingestion")
        }),
        new("Operations", "oi-cart", new NavEntry[]
        {
            new("orders", "oi-cart", "Orders"),
            new("documents", "oi-document", "Documents"),
            new("webhooks", "oi-bolt", "Webhooks"),
            new("cron-jobs", "oi-timer", "Cron Jobs")
        }),
        new("System", "oi-cog", new NavEntry[]
        {
            new("audit", "oi-clipboard", "Audit Logs"),
            new("users", "oi-people", "Users", "RequireAdmin"),
            new("api-tester", "oi-terminal", "API Tester", "RequireAdmin"),
            new("spr-simulation", "oi-pulse", "SPR Simulation", "RequireAdmin")
        })
    };

    private RenderFragment NavEntryLink(NavEntry entry) =>
        @<div class="nav-item px-3">
            <NavLink class="nav-link" href="@entry.Href">
                <span class="oi @entry.Icon" aria-hidden="true"></span> @entry.Label
            </NavLink>
        </div>;

    protected override void OnInitialized()
    {
        OpenGroupForCurrentPage();
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        // Opening the section that owns the current page keeps the sidebar honest when a user
        // arrives by link or bookmark rather than by clicking through the menu.
        if (OpenGroupForCurrentPage())
            StateHasChanged();
    }

    private bool OpenGroupForCurrentPage()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri)
            .Split('?')[0].Split('/')[0];

        if (string.IsNullOrEmpty(path))
            return false;   // Dashboard sits outside the groups.

        var owning = Groups.FirstOrDefault(g =>
            g.Items.Any(i => string.Equals(i.Href, path, StringComparison.OrdinalIgnoreCase)));

        return owning is not null && openGroups.Add(owning.Title);
    }

    private void ToggleGroup(string title)
    {
        if (!openGroups.Remove(title))
            openGroups.Add(title);
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}
